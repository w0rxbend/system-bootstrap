layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zjstatus"
        }
    }

    tab name="Main" split_direction="horizontal" cwd="~/" {
        pane name="Files" command="lsd" {
            args "-la"
        }
        pane split_direction="vertical" {
            pane command="btop" size="80%" borderless=true
            pane name="fastfetch" command="fastfetch" size="20%"
        }
    }

    tab name="Worxpace" split_direction="horizontal" cwd="~/Workspace/" {
        pane name="File Tree" command="eza" size="20%" {
            args "-la"
        }
        pane name="File Viewer" command="xplr" size="80%"
    }
}
