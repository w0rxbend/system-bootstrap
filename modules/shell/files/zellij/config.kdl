// Zellij 0.44: tmux-style keys, Dux theme, zjstatus bar.
//
// Keys: clear-defaults drops the stock Ctrl p/n/s/o/t/h/q mode keys, which
// clash with nvim (vim-tmux-navigator owns Ctrl h/j/k/l), zsh and fzf.
// Without a prefix, Zellij takes only Ctrl b, Ctrl g, Alt-* and Shift-arrows.
//   Ctrl b      tmux prefix (tmux mode); Ctrl b Ctrl b sends a literal Ctrl b
//   Ctrl g      lock: every key goes to the app until Ctrl g again
//   Ctrl b Ctrl p/t/n/h/s/o   pane / tab / resize / move / scroll / session mode
keybinds clear-defaults=true {
    normal {
    }
    locked {
        bind "Ctrl g" { SwitchToMode "Normal"; }
    }
    tmux {
        bind "Ctrl b" { Write 2; SwitchToMode "Normal"; }
        bind "Esc" "Ctrl c" { SwitchToMode "Normal"; }
        // Panes. New panes start in the focused pane's cwd, like -c "#{pane_current_path}".
        bind "\"" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "%" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "h" "Left" { MoveFocus "Left"; SwitchToMode "Normal"; }
        bind "j" "Down" { MoveFocus "Down"; SwitchToMode "Normal"; }
        bind "k" "Up" { MoveFocus "Up"; SwitchToMode "Normal"; }
        bind "l" "Right" { MoveFocus "Right"; SwitchToMode "Normal"; }
        bind "o" { FocusNextPane; SwitchToMode "Normal"; }
        bind "z" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
        bind "x" { CloseFocus; SwitchToMode "Normal"; }
        bind "!" { BreakPane; SwitchToMode "Normal"; }
        bind "{" { MovePaneBackwards; SwitchToMode "Normal"; }
        bind "}" { MovePane; SwitchToMode "Normal"; }
        bind "f" { ToggleFloatingPanes; SwitchToMode "Normal"; }
        bind "F" { TogglePaneEmbedOrFloating; SwitchToMode "Normal"; }
        bind "S" { ToggleActiveSyncTab; SwitchToMode "Normal"; }
        // Repeatable, like tmux bind -r: stay in tmux mode until Esc.
        bind "Space" { NextSwapLayout; }
        bind "Ctrl Left" { Resize "Increase Left"; }
        bind "Ctrl Down" { Resize "Increase Down"; }
        bind "Ctrl Up" { Resize "Increase Up"; }
        bind "Ctrl Right" { Resize "Increase Right"; }
        // Tabs (tmux windows). base-index 1, as in tmux.conf.
        bind "c" { NewTab; SwitchToMode "Normal"; }
        bind "," { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "n" { GoToNextTab; SwitchToMode "Normal"; }
        bind "p" { GoToPreviousTab; SwitchToMode "Normal"; }
        bind "Tab" { ToggleTab; SwitchToMode "Normal"; }
        bind "&" { CloseTab; SwitchToMode "Normal"; }
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "9" { GoToTab 9; SwitchToMode "Normal"; }
        // Copy mode: [ and Enter (tmux.conf binds Enter to copy-mode).
        bind "[" "Enter" { SwitchToMode "Scroll"; }
        bind "/" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "e" { EditScrollback; SwitchToMode "Normal"; }
        // Sessions.
        bind "d" { Detach; }
        bind "s" "w" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }
        // The full Zellij modes, behind the prefix.
        bind "Ctrl p" { SwitchToMode "Pane"; }
        bind "Ctrl t" { SwitchToMode "Tab"; }
        bind "Ctrl n" { SwitchToMode "Resize"; }
        bind "Ctrl h" { SwitchToMode "Move"; }
        bind "Ctrl s" { SwitchToMode "Scroll"; }
        bind "Ctrl o" { SwitchToMode "Session"; }
    }
    pane {
        bind "Ctrl p" { SwitchToMode "Normal"; }
        bind "h" "Left" { MoveFocus "Left"; }
        bind "l" "Right" { MoveFocus "Right"; }
        bind "j" "Down" { MoveFocus "Down"; }
        bind "k" "Up" { MoveFocus "Up"; }
        bind "p" { SwitchFocus; }
        bind "n" { NewPane; SwitchToMode "Normal"; }
        bind "d" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "r" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "s" { NewPane "stacked"; SwitchToMode "Normal"; }
        bind "x" { CloseFocus; SwitchToMode "Normal"; }
        bind "f" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
        bind "z" { TogglePaneFrames; SwitchToMode "Normal"; }
        bind "w" { ToggleFloatingPanes; SwitchToMode "Normal"; }
        bind "e" { TogglePaneEmbedOrFloating; SwitchToMode "Normal"; }
        bind "c" { SwitchToMode "RenamePane"; PaneNameInput 0; }
        bind "i" { TogglePanePinned; SwitchToMode "Normal"; }
    }
    tab {
        bind "Ctrl t" { SwitchToMode "Normal"; }
        bind "r" { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "h" "Left" "Up" "k" { GoToPreviousTab; }
        bind "l" "Right" "Down" "j" { GoToNextTab; }
        bind "n" { NewTab; SwitchToMode "Normal"; }
        bind "x" { CloseTab; SwitchToMode "Normal"; }
        bind "s" { ToggleActiveSyncTab; SwitchToMode "Normal"; }
        bind "b" { BreakPane; SwitchToMode "Normal"; }
        bind "]" { BreakPaneRight; SwitchToMode "Normal"; }
        bind "[" { BreakPaneLeft; SwitchToMode "Normal"; }
        bind "Tab" { ToggleTab; }
    }
    resize {
        bind "Ctrl n" { SwitchToMode "Normal"; }
        bind "h" "Left" { Resize "Increase Left"; }
        bind "j" "Down" { Resize "Increase Down"; }
        bind "k" "Up" { Resize "Increase Up"; }
        bind "l" "Right" { Resize "Increase Right"; }
        bind "H" { Resize "Decrease Left"; }
        bind "J" { Resize "Decrease Down"; }
        bind "K" { Resize "Decrease Up"; }
        bind "L" { Resize "Decrease Right"; }
        bind "=" "+" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
    }
    move {
        bind "Ctrl h" { SwitchToMode "Normal"; }
        bind "n" "Tab" { MovePane; }
        bind "p" { MovePaneBackwards; }
        bind "h" "Left" { MovePane "Left"; }
        bind "j" "Down" { MovePane "Down"; }
        bind "k" "Up" { MovePane "Up"; }
        bind "l" "Right" { MovePane "Right"; }
    }
    // Scroll and search keep vi keys, as tmux copy-mode-vi does.
    scroll {
        bind "Ctrl s" { SwitchToMode "Normal"; }
        bind "e" { EditScrollback; SwitchToMode "Normal"; }
        bind "/" "s" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "Ctrl c" "q" { ScrollToBottom; SwitchToMode "Normal"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl f" "PageDown" "Right" "l" { PageScrollDown; }
        bind "PageUp" "Left" "h" { PageScrollUp; }
        bind "d" "Ctrl d" { HalfPageScrollDown; }
        bind "u" "Ctrl u" { HalfPageScrollUp; }
        bind "g" "Home" { ScrollToTop; }
        bind "G" "End" { ScrollToBottom; }
    }
    search {
        bind "Ctrl s" { SwitchToMode "Normal"; }
        bind "Ctrl c" "q" { ScrollToBottom; SwitchToMode "Normal"; }
        bind "/" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl f" "PageDown" "Right" "l" { PageScrollDown; }
        bind "PageUp" "Left" "h" { PageScrollUp; }
        bind "d" "Ctrl d" { HalfPageScrollDown; }
        bind "u" "Ctrl u" { HalfPageScrollUp; }
        bind "n" { Search "down"; }
        bind "N" "p" { Search "up"; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }
    }
    entersearch {
        bind "Ctrl c" "Esc" { SwitchToMode "Scroll"; }
        bind "Enter" { SwitchToMode "Search"; }
    }
    renametab {
        bind "Ctrl c" { SwitchToMode "Normal"; }
        bind "Esc" { UndoRenameTab; SwitchToMode "Tab"; }
    }
    renamepane {
        bind "Ctrl c" { SwitchToMode "Normal"; }
        bind "Esc" { UndoRenamePane; SwitchToMode "Pane"; }
    }
    session {
        bind "Ctrl o" { SwitchToMode "Normal"; }
        bind "d" { Detach; }
        bind "q" { Quit; }
        bind "w" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }
        bind "l" {
            LaunchOrFocusPlugin "layout-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }
        bind "c" {
            LaunchOrFocusPlugin "configuration" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }
        bind "p" {
            LaunchOrFocusPlugin "plugin-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }
        bind "a" {
            LaunchOrFocusPlugin "about" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }
    }
    // No prefix. Alt arrows and Shift arrows match the bind -n keys in tmux.conf.
    shared_except "locked" {
        bind "Ctrl g" { SwitchToMode "Locked"; }
        bind "Alt h" "Alt Left" { MoveFocusOrTab "Left"; }
        bind "Alt l" "Alt Right" { MoveFocusOrTab "Right"; }
        bind "Alt j" "Alt Down" { MoveFocus "Down"; }
        bind "Alt k" "Alt Up" { MoveFocus "Up"; }
        bind "Alt H" "Shift Left" { GoToPreviousTab; }
        bind "Alt L" "Shift Right" { GoToNextTab; }
        bind "Alt n" { NewPane; }
        bind "Alt f" { ToggleFloatingPanes; }
        bind "Alt i" { MoveTab "Left"; }
        bind "Alt o" { MoveTab "Right"; }
        bind "Alt =" "Alt +" { Resize "Increase"; }
        bind "Alt -" { Resize "Decrease"; }
        bind "Alt [" { PreviousSwapLayout; }
        bind "Alt ]" { NextSwapLayout; }
    }
    shared_except "normal" "locked" "tmux" {
        bind "Enter" "Esc" { SwitchToMode "Normal"; }
    }
    shared_except "tmux" "locked" {
        bind "Ctrl b" { SwitchToMode "Tmux"; }
    }
}

// Plugin aliases. Changes need a restart.
plugins {
    tab-bar location="zellij:tab-bar"
    status-bar location="zellij:status-bar"
    strider location="zellij:strider"
    compact-bar location="zellij:compact-bar"
    session-manager location="zellij:session-manager"
    welcome-screen location="zellij:session-manager" {
        welcome_screen true
    }
    filepicker location="zellij:strider" {
        cwd "/"
    }
    configuration location="zellij:configuration"
    plugin-manager location="zellij:plugin-manager"
    layout-manager location="zellij:layout-manager"
    about location="zellij:about"
    // Status bar for every layout. Pinned: zjstatus v0.23.0 is built on
    // zellij-tile 0.44.1. Zellij 0.45+ needs zjstatus v0.25.0 or newer.
    // First start: focus the bar and press y to grant its permissions.
    zjstatus location="https://github.com/dj95/zjstatus/releases/download/v0.25.0/zjstatus.wasm" {
        color_bg "#141218"
        color_surface "#2b292f"
        color_outline "#49454e"
        color_muted "#948f99"
        color_fg "#e6e0e9"
        color_primary "#d0bcff"
        color_on_primary "#381e72"
        color_container "#4f378b"
        color_secondary "#ccc2dc"
        color_error "#f2b8b5"

        format_left "{mode}#[bg=$surface,fg=$primary,bold]  {session} #[bg=$bg,fg=$surface]"
        format_center "{tabs}"
        format_right "{swap_layout}{datetime}"
        format_space "#[bg=$bg]"
        format_hide_on_overlength "true"
        format_precedence "lrc"

        // One frame-less pane looks like plain tmux; frames return with a split.
        hide_frame_for_single_pane "true"

        mode_normal "#[bg=$primary,fg=$on_primary,bold] {name} #[bg=$surface,fg=$primary]"
        mode_locked "#[bg=$outline,fg=$fg,bold] 󰌾 {name} #[bg=$surface,fg=$outline]"
        mode_tmux "#[bg=$error,fg=$on_primary,bold] 󰘳 {name} #[bg=$surface,fg=$error]"
        mode_resize "#[bg=$secondary,fg=$on_primary,bold] {name} #[bg=$surface,fg=$secondary]"
        mode_default_to_mode "resize"

        tab_normal "#[bg=$bg,fg=$muted] {index} {name} {floating_indicator}{sync_indicator}{fullscreen_indicator}"
        tab_active "#[bg=$bg,fg=$container]#[bg=$container,fg=$fg,bold]{index} {name} {floating_indicator}{sync_indicator}{fullscreen_indicator}#[bg=$bg,fg=$container] "
        tab_rename "#[bg=$bg,fg=$error]#[bg=$error,fg=$on_primary,bold]{index} {name}#[bg=$bg,fg=$error] "
        tab_floating_indicator "󰹙 "
        tab_sync_indicator "󰓦 "
        tab_fullscreen_indicator "󰊓 "

        swap_layout_format "#[bg=$bg,fg=$muted] 󰕰 {name} "
        swap_layout_hide_if_empty "true"

        datetime "#[bg=$bg,fg=$surface]#[bg=$surface,fg=$secondary] 󰥔 {format} "
        datetime_format "%a %d %b %H:%M"
        datetime_timezone "Europe/Kyiv"
    }
}

load_plugins {
    "zellij:link"
}

// Dux (Dank Material Shell) dark purple, Material 3. Same palette as
// modules/sway/files/alacritty/wm.toml. DMS ships no Zellij matugen template.
themes {
    dux {
        text_unselected {
            base "#e6e0e9"
            background "#141218"
            emphasis_0 "#f2b8b5"
            emphasis_1 "#d0bcff"
            emphasis_2 "#ccc2dc"
            emphasis_3 "#cac4cf"
        }
        text_selected {
            base "#e6e0e9"
            background "#36343a"
            emphasis_0 "#f2b8b5"
            emphasis_1 "#d0bcff"
            emphasis_2 "#ccc2dc"
            emphasis_3 "#cac4cf"
        }
        ribbon_selected {
            base "#381e72"
            background "#d0bcff"
            emphasis_0 "#8c1d18"
            emphasis_1 "#4f378b"
            emphasis_2 "#141218"
            emphasis_3 "#381e72"
        }
        ribbon_unselected {
            base "#e6e0e9"
            background "#2b292f"
            emphasis_0 "#f2b8b5"
            emphasis_1 "#d0bcff"
            emphasis_2 "#ccc2dc"
            emphasis_3 "#cac4cf"
        }
        table_title {
            base "#d0bcff"
            background "#141218"
            emphasis_0 "#f2b8b5"
            emphasis_1 "#ccc2dc"
            emphasis_2 "#cac4cf"
            emphasis_3 "#948f99"
        }
        table_cell_selected {
            base "#e6e0e9"
            background "#4f378b"
            emphasis_0 "#f2b8b5"
            emphasis_1 "#ffffff"
            emphasis_2 "#ccc2dc"
            emphasis_3 "#cac4cf"
        }
        table_cell_unselected {
            base "#e6e0e9"
            background "#141218"
            emphasis_0 "#f2b8b5"
            emphasis_1 "#d0bcff"
            emphasis_2 "#ccc2dc"
            emphasis_3 "#cac4cf"
        }
        list_selected {
            base "#e6e0e9"
            background "#4f378b"
            emphasis_0 "#f2b8b5"
            emphasis_1 "#ffffff"
            emphasis_2 "#ccc2dc"
            emphasis_3 "#cac4cf"
        }
        list_unselected {
            base "#e6e0e9"
            background "#141218"
            emphasis_0 "#f2b8b5"
            emphasis_1 "#d0bcff"
            emphasis_2 "#ccc2dc"
            emphasis_3 "#cac4cf"
        }
        frame_selected {
            base "#d0bcff"
            background "#141218"
            emphasis_0 "#f2b8b5"
            emphasis_1 "#ccc2dc"
            emphasis_2 "#cac4cf"
            emphasis_3 "#948f99"
        }
        frame_unselected {
            base "#49454e"
            background "#141218"
            emphasis_0 "#948f99"
            emphasis_1 "#948f99"
            emphasis_2 "#948f99"
            emphasis_3 "#948f99"
        }
        frame_highlight {
            base "#f2b8b5"
            background "#141218"
            emphasis_0 "#d0bcff"
            emphasis_1 "#f2b8b5"
            emphasis_2 "#f2b8b5"
            emphasis_3 "#f2b8b5"
        }
        exit_code_success {
            base "#ccc2dc"
            background "#141218"
            emphasis_0 "#d0bcff"
            emphasis_1 "#141218"
            emphasis_2 "#cac4cf"
            emphasis_3 "#948f99"
        }
        exit_code_error {
            base "#f2b8b5"
            background "#141218"
            emphasis_0 "#cac4cf"
            emphasis_1 "#8c1d18"
            emphasis_2 "#948f99"
            emphasis_3 "#948f99"
        }
    }
}

theme "dux"

ui {
    pane_frames {
        rounded_corners true
        // zjstatus shows the session name.
        hide_session_name true
    }
}

// zjstatus toggles frames itself (hide_frame_for_single_pane); its docs ask
// for frames off here so the two do not fight.
pane_frames false
// 0.45 draws title-only frames by default; keep full rounded frames when zjstatus turns them on.
pane_frame_style "full"
auto_layout true
default_shell "zsh"
on_force_close "quit"
session_serialization true
mouse_mode true
copy_command "wl-copy"
copy_on_select true
scrollback_editor "nvim"
show_startup_tips false
show_release_notes false
