// ! AUTO-GENERATED BY DMS !
// ! CHANGES WILL BE OVERWRITTEN !
// ! PLACE YOUR CUSTOM CONFIGURATION ELSEWHERE !

input {
    mouse {
        accel-speed 0.0
        natural-scroll
    }
    touchpad {
        tap
        accel-speed 0.0
        natural-scroll
        disabled-on-external-mouse
        dwt
        middle-emulation
    }
    keyboard {
        xkb {
            layout "us,ua"
            options "grp:win_space_toggle"
        }
        track-layout "window"
    }
}
