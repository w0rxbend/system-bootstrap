# Arch + Sway. Stock keybinds from /etc/sway/config, with the chrome swapped:
# Waybar instead of swaybar, Fuzzel instead of wmenu/wofi, Kanshi for outputs.
# Palette from the Dux dark purple theme. Borders are 1px.
# bg #141218, outline #948f99, text #e6e0e9, primary #d0bcff,
# spawn edge #4f378b, error #f2b8b5.
# Do not set output mode or position here. Kanshi owns that, and repeats this scale.

set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term alacritty
set $menu fuzzel
set $scripts ~/.config/sway/scripts
set $bg #141218
set $line #948f99
set $dim #49454e
set $text #e6e0e9
set $accent #d0bcff
set $edge #4f378b
set $red #f2b8b5

output * bg $bg solid_color

# Modest scale for the 4K panel. Linear filtering keeps fractional scale from looking blocky.
output "Dell Inc. DELL P3223QE 6BVG3P3" scale 1.25
output "Dell Inc. DELL P3223QE 6BVG3P3" scale_filter linear

# Mice only. Touchpads are type:touchpad and stay on classic scrolling.
input type:pointer {
    natural_scroll enabled
}

# US, then Ukrainian. Super+Space is the XKB switch, so Sway does not bind it.
input type:keyboard {
    xkb_layout us,ua
    xkb_options grp:win_space_toggle
}

font pango:RecMonoLinear Nerd Font Mono 16
default_border pixel 1
default_floating_border pixel 1
titlebar_border_thickness 1
titlebar_padding 6 3
gaps inner 2
gaps outer 0
smart_borders on

# class                  border   background text     indicator child_border
# The indicator is the one edge where the next window opens. Same color
# for a side spawn and a below spawn.
client.focused           $accent $bg   $text $edge   $accent
client.focused_inactive  $line   $bg   $text $line   $line
client.focused_tab_title $accent $bg   $text
client.unfocused         $line   $bg   $text $line   $line
client.urgent            $red    $bg   $text $red    $red
client.placeholder       $line   $bg   $dim  $line   $line
client.background        $bg

exec_always "pkill -x waybar || true; exec waybar"
exec_always "pkill -x kanshi || true; exec kanshi"
exec_always "pkill -x mako || true; exec mako"
exec_always "pkill -x swayidle || true; exec $scripts/idle.sh"
exec_always "pkill -x autotiling || true; exec autotiling"
# skbd is the layout daemon. SWAYSOCK changes every Sway start, so the unit
# is restarted here instead of enabled at login.
exec_always "systemctl --user cat skbd.service >/dev/null 2>&1 && systemctl --user import-environment SWAYSOCK && systemctl --user restart skbd.service"
exec_always "$scripts/sunset.sh"
exec_always "pkill -x wpaperd || true; exec wpaperd -d"
exec_always "$scripts/wob.sh"
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store

bindsym $mod+Return exec $term
bindsym $mod+Shift+q kill
bindsym $mod+d exec $menu
floating_modifier $mod normal
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec $scripts/power-menu.sh
bindsym $mod+Escape exec $scripts/lock.sh
bindsym $mod+Shift+a exec $scripts/audio-menu.py

bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+Ctrl+space focus mode_toggle
bindsym $mod+a focus parent

bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

bindsym --locked XF86AudioMute exec $scripts/volume.sh mute
bindsym --locked XF86AudioLowerVolume exec $scripts/volume.sh down
bindsym --locked XF86AudioRaiseVolume exec $scripts/volume.sh up
bindsym --locked XF86AudioMicMute exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioPause exec playerctl play-pause
bindsym --locked XF86AudioPrev exec playerctl previous
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioStop exec playerctl stop
bindsym --locked XF86MonBrightnessDown exec $scripts/brightness.sh down
bindsym --locked XF86MonBrightnessUp exec $scripts/brightness.sh up

bindsym Print exec $scripts/screenshot.sh region
bindsym Shift+Print exec $scripts/screenshot.sh output
bindsym $mod+Print exec $scripts/screenshot.sh window
bindsym $mod+Shift+r exec $scripts/record.sh toggle-output
bindsym $mod+Alt+r exec $scripts/record.sh toggle-region
bindsym $mod+Shift+v exec $scripts/cliphist.sh pick
bindsym $mod+Alt+v exec $scripts/cliphist.sh delete
bindsym $mod+Shift+g exec pkill -USR1 -x wlsunset

include /etc/sway/config.d/*
