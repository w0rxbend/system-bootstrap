# tmux autostart (terminal configs set WITH_TMUX=true). It runs first so the outer
# terminal shell skips the full init below; only the shell inside tmux pays for it.
# exec: leaving tmux closes the terminal instead of dropping into a second shell.
# WAYLAND_DISPLAY covers Wayland sessions without Xwayland, where DISPLAY is unset.
if [[ $WITH_TMUX == true && -z $TMUX && $- == *i* ]] && (( $+commands[tmux] )) &&
  [[ -n $DISPLAY || -n $WAYLAND_DISPLAY ]]; then
  tmux_session="$(tmux ls 2>/dev/null | grep -vm1 attached | cut -d: -f1)"
  if [[ -z $tmux_session ]]; then
    exec tmux new-session
  else
    exec tmux attach-session -t "$tmux_session"
  fi
fi

# Keep PATH entries unique; nested shells (tmux panes) would otherwise append everything again.
typeset -U path PATH

# pyenv itself is initialised once, by the OMZ pyenv plugin (it also runs pyenv-virtualenv init).
export PYENV_ROOT="$HOME/.pyenv"
