# Tool dirs. (N-/) keeps only dirs that exist. ~/.apps/*/bin covers every binstaller
# tool (binstaller appsDir), so a new tool needs no edit here. It goes first, so the
# pinned copies win over stale system ones (/usr/local/bin/helm, /usr/bin/yq).
export DENO_INSTALL="$HOME/.deno"
path=(~/.apps/*/bin(N-/) $path)
path+=(
  ~/.local/bin
  ~/.go/bin
  ~/.local/share/coursier/bin(N-/)
  ~/.local/kitty.app/bin(N-/)
  ~/.platformio/penv/bin(N-/)
  ~/.local/share/JetBrains/Toolbox/{scripts,apps}(N-/)
  ~/.local/share/flatpak/exports/bin(N-/)
  $DENO_INSTALL/bin(N-/)
)

